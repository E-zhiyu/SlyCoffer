<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    style="@style/MediumRadiusCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="15dp"
        android:paddingBottom="10dp">

        <!-- 复选框 -->
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:id="@+id/checked_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="?android:attr/listChoiceIndicatorMultiple"
            android:elevation="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 备注 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/remark"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constraintEnd_toStartOf="@id/amount_text"
            app:layout_constraintStart_toEndOf="@id/checked_text"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 时间、种类、自动记账标签 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/type_time_auto_tag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/date_time"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOutline"
            app:layout_constraintStart_toEndOf="@id/checked_text"
            app:layout_constraintTop_toBottomOf="@id/remark_text" />

        <!-- 位置 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/location_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/account_location"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOutline"
            app:layout_constraintStart_toEndOf="@id/checked_text"
            app:layout_constraintTop_toBottomOf="@id/type_time_auto_tag_text" />

        <!-- 金额 -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/amount_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/amount"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>