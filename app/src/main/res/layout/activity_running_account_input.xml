<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.pages.main.bookkeeping.RunningAccountInputActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            style="@style/CollapsingToolbarLayoutStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
            app:toolbarId="@id/toolbar">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:title="@string/add_running_account">

                <ImageButton
                    android:id="@+id/confirm_button"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="15dp"
                    android:contentDescription="@string/confirm_btn"
                    android:src="@drawable/outline_check_24" />
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:id="@+id/scroll_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- 金额 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amount_layout"
                style="@style/CommonTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="false"
                app:endIconDrawable="@drawable/baseline_clear_24"
                app:endIconMode="clear_text"
                app:helperText="@string/account_amount_help">

                <requestFocus />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/amount_input"
                    style="@style/UserInputEditTextStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/amount"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 备注 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/remark_layout"
                style="@style/CommonTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/remark"
                app:helperText="@string/account_remark_help">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/remark_input"
                    style="@style/UserInputEditTextStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 日期和时间 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/datetime_layout"
                style="@style/CommonTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/date_time"
                app:endIconMode="none"
                app:helperText="@string/account_datetime_help">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/datetime_input"
                    style="@style/UneditableAutoCompleteTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 流水类型 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/type_layout"
                style="@style/DropdownMenuTextInputLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/running_account_type"
                app:helperText="@string/account_type_help">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/type_input"
                    style="@style/UneditableAutoCompleteTextViewStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 转账相关输入项 -->
            <LinearLayout
                android:id="@+id/transfer_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 转出账户 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/export_account_layout"
                    style="@style/DropdownMenuTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperText="@string/account_export_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/export_account_input"
                        style="@style/EditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/export_account" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 转入账户 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/import_account_layout"
                    style="@style/DropdownMenuTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperText="@string/account_import_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/import_account_input"
                        style="@style/EditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/import_account" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 还款额外输入项 -->
            <LinearLayout
                android:id="@+id/repay_extra_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 关联的借款记录 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/related_loan_layout"
                    style="@style/CommonTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperText="@string/account_related_loan_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/related_loan_input"
                        style="@style/UneditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/loan_record" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- 借款（入/出）额外输入项 -->
            <LinearLayout
                android:id="@+id/loan_extra_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 借款对象 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/loan_target_name_layout"
                    style="@style/DropdownMenuTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperText="@string/account_loan_target_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/loan_target_name_input"
                        style="@style/EditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/loan_target" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 应还日期 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/repay_date_layout"
                    style="@style/CommonTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="clear_text"
                    app:helperText="@string/account_repay_date_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/repay_date_input"
                        style="@style/UneditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/repay_date" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 结息周期 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/interest_period_layout"
                    style="@style/DropdownMenuTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperText="@string/account_interest_period_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/interest_period_input"
                        style="@style/UneditableAutoCompleteTextViewStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/interest_accrual_period" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 年利率 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/annual_interest_rate_layout"
                    style="@style/CommonTextInputLayoutStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconCheckable="false"
                    app:endIconDrawable="@drawable/outline_percent_24"
                    app:endIconMode="custom"
                    app:helperText="@string/account_annual_interest_rate_help">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/annual_interest_rate_input"
                        style="@style/UserInputEditTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/annual_interest_rate"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/compound_interest_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/allow_compound_interest"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                style="@style/Widget.Material3.MaterialDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- 标签 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/account_tag"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 标签选择按钮 -->
                <ImageButton
                    android:id="@+id/tag_select_btn"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_of_media_add"
                    android:src="@drawable/outline_edit_note_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tag_explain_btn"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 说明按钮 -->
                <ImageButton
                    android:id="@+id/tag_explain_btn"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_of_explanation"
                    android:src="@drawable/outline_help_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tag_recycler"
                style="@style/ChipRecyclerViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager" />

            <com.google.android.material.divider.MaterialDivider
                style="@style/Widget.Material3.MaterialDivider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- 图片操纵按钮布局 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/media_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/media_file"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 删除按钮 -->
                <ImageButton
                    android:id="@+id/media_delete_btn"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_of_media_delete"
                    android:src="@drawable/outline_delete_24"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/media_explain_btn"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 添加按钮 -->
                <ImageButton
                    android:id="@+id/media_add_btn"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_of_media_add"
                    android:src="@drawable/outline_add_photo_alternate_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/media_explain_btn"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 说明按钮 -->
                <ImageButton
                    android:id="@+id/media_explain_btn"
                    style="@style/ImageButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_of_explanation"
                    android:src="@drawable/outline_help_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/media_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>